FROM python:3.14-slim-bookworm AS dev

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl build-essential \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/pyproject.toml /app/pyproject.toml
COPY apps/api/alembic.ini /app/alembic.ini
COPY apps/api/alembic /app/alembic
COPY apps/api/src /app/src
COPY apps/api/tests /app/tests

RUN pip install --no-cache-dir -e .[dev]

EXPOSE 8080

CMD ["sh", "-c", "alembic upgrade head && uvicorn rekenraam_api.app:app --host ${APP_HOST:-0.0.0.0} --port ${APP_PORT:-8080} --reload --reload-dir /app/src --reload-dir /app/tests"]
