{
  "name": "rekenraam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend --prefix-colors blue,green \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "cross-env APP_ENV=development TRUST_PROXY_HEADERS=1 TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128 ./scripts/go-backend.sh run ./cmd/rekenraam",
    "dev:frontend": "pnpm --dir frontend run dev",
    "test:backend": "./scripts/test-backend.sh",
    "test:frontend": "./scripts/test-frontend.sh",
    "test:e2e": "./scripts/test-e2e.sh",
    "test:e2e-smoke": "./scripts/test-e2e-smoke.sh",
    "test:release-preflight": "./scripts/test-release-preflight.sh",
    "check:post-merge": "./scripts/check-post-merge.sh",
    "measure:large-book": "./scripts/measure-large-book.sh",
    "measure:payment-in-lieu-density": "./scripts/measure-payment-in-lieu-density.sh",
    "build": "./scripts/build-single-binary.sh",
    "website:dev": "node website/preview.mjs --dev",
    "website:build": "node website/build.mjs",
    "website:preview": "node website/preview.mjs",
    "website:check": "node --test --test-isolation=none website/build.test.mjs",
    "website:check-browser": "pnpm --dir e2e exec playwright test --config=website-check.config.ts"
  },
  "devDependencies": {
    "concurrently": "10.0.7",
    "cross-env": "10.1.0"
  }
}
