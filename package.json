{
  "name": "rekenraam",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.9.1+sha512.06b055fff5cd20dc12781de173ced3310ce0951bf2ec620211a16045d5444d5c93a663210764ef29a653a610459ba0368f0e74f84d80c54723cf95aae7bc0d6d",
  "scripts": {
    "dev": "concurrently --kill-others --names backend,frontend --prefix-colors blue,green \"pnpm run dev:backend\" \"pnpm run dev:frontend\"",
    "dev:backend": "cd backend && cross-env APP_ENV=development TRUST_PROXY_HEADERS=1 TRUSTED_PROXY_CIDRS=127.0.0.0/8,::1/128 go run ./cmd/rekenraam",
    "dev:frontend": "pnpm --dir frontend run dev",
    "test:backend": "./scripts/test-backend.sh",
    "test:frontend": "./scripts/test-frontend.sh",
    "test:e2e": "./scripts/test-e2e.sh",
    "test:e2e-smoke": "./scripts/test-e2e-smoke.sh",
    "test:release-preflight": "./scripts/test-release-preflight.sh",
    "build": "./scripts/build-single-binary.sh"
  },
  "devDependencies": {
    "concurrently": "10.0.5",
    "cross-env": "10.1.0"
  }
}
