POSTGRES_DB=rekenraam
POSTGRES_USER=rekenraam
POSTGRES_PASSWORD_FILE=./secrets/postgres_password.txt
# Basic SQLite deployments do not need database settings; the app stores its
# database at /data/rekenraam.sqlite3 inside the mounted volume.
FIRST_ADMIN_EMAIL=admin@example.test
FIRST_ADMIN_PASSWORD_FILE=./secrets/first_admin_password.txt
FIRST_ADMIN_DISPLAY_NAME=Admin

REKENRAAM_PUBLIC_HOST=finance.example.com
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
FRONTEND_PORT=3000
FRONTEND_PUBLIC_API_BASE_URL=/api/v1
CORS_ALLOWED_ORIGINS=https://finance.example.com
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
TRUSTED_PROXY_CIDRS=172.16.0.0/12,10.0.0.0/8,192.168.0.0/16

MFA_ENFORCED=false
MFA_SECRET_KEY=replace-with-a-long-random-string

BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
