{
    "name": "rekenraam-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "openapi:generate": "openapi-typescript ../api/openapi/openapi.yaml -o ./src/lib/api/schema.d.ts",
        "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy baseLocale --emit-ts-declarations",
        "dev": "pnpm run openapi:generate && vite --host 0.0.0.0 --port 1888 --strictPort",
        "build": "pnpm run openapi:generate && pnpm run paraglide:compile && vite build",
        "preview": "vite preview",
        "check": "pnpm run openapi:generate && pnpm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run"
    },
    "devDependencies": {
        "@internationalized/date": "3.12.2",
        "@lucide/svelte": "1.25.0",
        "@sveltejs/adapter-static": "3.0.10",
        "@sveltejs/kit": "2.70.1",
        "@sveltejs/vite-plugin-svelte": "7.2.0",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "26.1.1",
        "@vitest/ui": "4.1.10",
        "bits-ui": "2.18.1",
        "clsx": "2.1.1",
        "openapi-typescript": "7.13.0",
        "shadcn-svelte": "1.4.2",
        "svelte": "5.56.8",
        "svelte-check": "4.7.3",
        "tailwind-merge": "3.6.0",
        "tailwind-variants": "3.2.2",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3",
        "vite": "8.1.5",
        "vitest": "4.1.10"
    },
    "dependencies": {
        "@inlang/paraglide-js": "2.22.0",
        "@tanstack/svelte-query": "6.1.36",
        "date-fns": "4.4.0",
        "dinero.js": "2.0.2",
        "openapi-fetch": "0.17.0"
    }
}
