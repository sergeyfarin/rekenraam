{
    "name": "rekenraam-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "openapi:generate": "openapi-typescript ../api/openapi/openapi.yaml -o ./src/lib/api/schema.d.ts",
        "paraglide:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy localStorage preferredLanguage baseLocale --emit-ts-declarations",
        "dev": "pnpm run openapi:generate && vite --port 1888 --strictPort",
        "build": "pnpm run openapi:generate && pnpm run paraglide:compile && vite build",
        "preview": "vite preview",
        "check": "pnpm run openapi:generate && pnpm run paraglide:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
        "test": "vitest run"
    },
    "devDependencies": {
        "@inlang/plugin-m-function-matcher": "2.2.16",
        "@inlang/plugin-message-format": "4.4.4",
        "@internationalized/date": "3.12.4",
        "@lucide/svelte": "1.47.0",
        "@sveltejs/adapter-static": "3.0.10",
        "@sveltejs/kit": "2.70.3",
        "@sveltejs/vite-plugin-svelte": "7.3.1",
        "@tailwindcss/vite": "4.3.3",
        "@types/node": "26.6.2",
        "@vitest/ui": "5.0.1",
        "bits-ui": "2.19.3",
        "clsx": "2.1.1",
        "openapi-typescript": "7.13.0",
        "shadcn-svelte": "1.7.0",
        "svelte": "5.57.1",
        "svelte-check": "4.7.6",
        "tailwind-merge": "3.7.0",
        "tailwind-variants": "3.3.1",
        "tailwindcss": "4.3.3",
        "tw-animate-css": "1.4.0",
        "typescript": "5.9.3",
        "vite": "8.3.0",
        "vitest": "5.0.1"
    },
    "dependencies": {
        "@inlang/paraglide-js": "2.25.4",
        "@tanstack/svelte-query": "6.2.4",
        "@tanstack/svelte-table": "9.2.4",
        "date-fns": "4.4.0",
        "minisearch": "^7.2.0",
        "openapi-fetch": "0.17.0"
    }
}
